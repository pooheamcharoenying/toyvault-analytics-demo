# =============================================================================
# Nichiworld Railway App Backend — Production Environment Variables
# =============================================================================
# Copy this to .env for local testing, or set these as env vars on Railway.
#
# On Railway: Settings > Variables for each service
# =============================================================================

# --- Basic Auth (same for dev and prod) ---
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=$2b$12$... # bcrypt hash of your password

# --- DigitalOcean Spaces (production data source) ---
DO_ACCESS_KEY=your_access_key
DO_SECRET_KEY=your_secret_key
DO_SPACE_NAME=nichiworld2
DO_REGION=sgp1

# --- CORS: Allowed frontend origins (comma-separated) ---
# CRITICAL for production! Must include your Railway frontend URL.
# Example: https://nichiworld-frontend.up.railway.app
ALLOWED_ORIGINS=https://YOUR-FRONTEND.up.railway.app

# --- Data Server (DO NOT SET IN PRODUCTION) ---
# DATA_SERVER_URL is for local dev only (2-server architecture).
# In production, leave this UNSET so the backend loads directly from Spaces.
# DATA_SERVER_URL=  <-- do NOT set this on Railway
