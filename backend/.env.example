# =========================================================================
# ToyVault Backend — environment variables
# Copy to .env for local dev, or set as variables in Railway for production.
# =========================================================================

# --- Public demo mode ---
# true  -> auth disabled, anyone can hit the API (use for Railway demo deploy)
# false -> Basic Auth required (BASIC_AUTH_USERNAME + BASIC_AUTH_PASSWORD_HASH)
PUBLIC_MODE=true

# --- Basic Auth (ignored when PUBLIC_MODE=true) ---
BASIC_AUTH_USERNAME=admin
# bcrypt hash of your password (generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'YOURPASS', bcrypt.gensalt()).decode())")
BASIC_AUTH_PASSWORD_HASH=

# --- Data source ---
# Pick ONE of the following paths:
#
# (A) Public URL to the Excel file (recommended for Railway demo).
#     Can be a GitHub Release asset URL, Cloudflare R2 public URL, etc.
#     The backend downloads, caches to .excel_cache/, and parses on startup.
EXCEL_SOURCE_URL=

# (B) DigitalOcean Spaces (legacy path — leave empty if using EXCEL_SOURCE_URL)
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_SPACE_NAME=toyvault-demo
DO_REGION=sgp1

# (C) Local dev only — 2-server architecture (leave unset for production)
# DATA_SERVER_URL=http://localhost:8458

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# For Railway deploy, set this to your frontend's public URL.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3457
